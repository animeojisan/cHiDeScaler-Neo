# Build output
/target/
*.pdb

# Local application state
/settings.json
/dlssnr_presets.json
/*.log
/logs/
cache/
caches/
_diagnostics/

# Generated/local binaries
/cHiDeScaler-Neo.exe
/cHiDeScaler-Neo_previous.exe

# TensorRT local backend pack and generated engines
/backends/tensorrt/*.dll
/backends/tensorrt/*.lib
/backends/tensorrt/*.engine
/backends/tensorrt/cache/
/backends/tensorrt/_diagnostics/

# DLSS Neural Rendering local build/runtime files
# The public bridge DLL and backend.json are intentionally kept in the source package.
/backends/dlssnr/*.dll
!/backends/dlssnr/neo_dlssnr_backend.dll
/backends/dlssnr/*.lib
/backends/dlssnr/runtime/*
!/backends/dlssnr/runtime/README.txt
/backends/dlssnr/_diagnostics/

# Editor / OS
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db
# Local/private development artifacts
*.user
*.suo
*.tmp
*.bak
*.old
*.dmp
*.etl
*.trace
*.zip
*.7z
*.rar
*.engine
*.profile
*.cache
/.cargo/
/_audit/
/_scratch/
/build/
/external/

# User-supplied Slang shader packs (keep only bundled instructions)
/slangp/*
!/slangp/README_en.txt
!/slangp/README_ja.txt
